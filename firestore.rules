rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: is the requesting user a member of this trip? ───
    // We use member_ids (flat array on the doc) so collection queries work.
    // exists() only works for single-document reads, not collection queries.
    function isMember(tripData) {
      return request.auth.uid in tripData.member_ids;
    }
    function isKaptan(tripData) {
      return tripData.kaptan_id == request.auth.uid;
    }

    // ───── TRIPS ─────
    match /trips/{tripId} {
      // Single-doc reads (get): strict check — user must be kaptan or member.
      // This covers TripOverviewPage and any doc-by-ID fetch.
      allow get: if (resource.data.isPublic == true) || (request.auth != null && (
        isKaptan(resource.data) ||
        isMember(resource.data)
      ));

      // Collection queries (list): allow any authenticated user.
      // Safe because every client query filters by member_ids array-contains
      // the caller's own uid, so Firestore only returns their trips.
      // Firestore cannot evaluate resource.data in collection queries, so a
      // per-document check here would always deny — this is the correct model.
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isKaptan(resource.data) ||
        (
          resource.data.mode == 'GROUP_FULL' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_ids']) &&
          (
             // Joining: uid wasn't in array, now it is
             (!isMember(resource.data) && request.auth.uid in request.resource.data.member_ids) ||
             // Leaving: uid was in array, now it isn't
             (isMember(resource.data) && !(request.auth.uid in request.resource.data.member_ids))
          )
        )
      );
      allow delete: if request.auth != null && isKaptan(resource.data);

      // ───── MEMBERS SUBCOLLECTION ─────
      // Individual doc reads/writes only (no collection queries needed from client)
      match /members/{memberId} {
        allow read: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
        allow write: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          request.auth.uid == memberId
        );
      }

      // ───── EXPENSES SUBCOLLECTION ─────
      match /expenses/{expenseId} {
        allow read: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
        allow create: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        ) &&
        request.resource.data.amount > 0 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.paid_by_id != null;
        allow update: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          (
            resource.data.get('created_by', resource.data.paid_by_id) == request.auth.uid &&
            resource.data.status != 'APPROVED'
          )
        ) &&
        request.resource.data.amount > 0 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0;

        allow delete: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          (
            resource.data.get('created_by', resource.data.paid_by_id) == request.auth.uid &&
            resource.data.status != 'APPROVED'
          )
        );
      }

      // ───── SETTLEMENTS SUBCOLLECTION ─────
      match /settlements/{settlementId} {
        allow read: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
        allow create, update, delete: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
      }

      // ───── ITINERARY SUBCOLLECTION ─────
      match /itinerary/{stopId} {
        allow read: if (get(/databases/$(database)/documents/trips/$(tripId)).data.isPublic == true) || (request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        ));
        allow create, update, delete: if request.auth != null &&
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
      // ───── PLANS SUBCOLLECTION ─────
      match /plans/{planId} {
        allow read: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
        allow create, update, delete: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
      }

      // ───── SUGGESTIONS SUBCOLLECTION ─────
      match /suggestions/{suggestionId} {
        allow read: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
        allow create, update, delete: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
      }

      // ───── ACTIVITY LOG SUBCOLLECTION ─────
      match /activity_log/{logId} {
        allow read: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
        allow create: if request.auth != null && (
          isKaptan(get(/databases/$(database)/documents/trips/$(tripId)).data) ||
          isMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
        );
      }
    }

    // ───── USERS ─────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
